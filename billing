<script>
  let grandTotal = 0;
  let billCount = localStorage.getItem('billCount') || 0;
  let dailySales = localStorage.getItem('dailySales') || 0;
  let billNo = localStorage.getItem('billNo') || 1;

  const now = new Date();
  document.getElementById('billDate').innerText = now.toLocaleDateString('en-IN');
  document.getElementById('billTime').innerText = now.toLocaleTimeString('en-IN');

  document.getElementById('billCount').innerText = billCount;
  document.getElementById('dailySales').innerText = dailySales;
  document.getElementById('billNo').value = billNo;

  function addItem() {
    const itemSelect = document.getElementById('item');
    const price = Number(itemSelect.value);
    const itemName = itemSelect.options[itemSelect.selectedIndex].text;
    const qty = Number(document.getElementById('qty').value);
    if (!price || qty <= 0) return alert('Select item and quantity');
    const total = price * qty;
    grandTotal += total;
    const table = document.getElementById('billTable');
    const row = table.insertRow();
    row.insertCell(0).innerText = itemName.split('–')[0];
    row.insertCell(1).innerText = qty;
    row.insertCell(2).innerText = price;
    row.insertCell(3).innerText = total;
    const del = row.insertCell(4);
    del.innerHTML = '❌';
    del.onclick = () => { grandTotal -= total; document.getElementById('grandTotal').innerText = grandTotal; row.remove(); };
    document.getElementById('grandTotal').innerText = grandTotal;
  }

  function saveBill() {
    if (grandTotal === 0) return alert('No items added');
    const today = new Date().toISOString().split('T')[0];
    let salesData = JSON.parse(localStorage.getItem('salesData') || '{}');
    if (!salesData[today]) salesData[today] = { bills: 0, total: 0 };
    salesData[today].bills += 1;
    salesData[today].total += grandTotal;
    localStorage.setItem('salesData', JSON.stringify(salesData));
    billCount++; dailySales = Number(dailySales) + grandTotal;
    localStorage.setItem('billCount', billCount);
    localStorage.setItem('dailySales', dailySales);
    billNo++; localStorage.setItem('billNo', billNo);
    alert('Bill Saved'); location.reload();
  }

  function printBill() { window.print(); }

  let deferredPrompt;
  window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault(); deferredPrompt = e;
    document.getElementById('installBtn').style.display = 'block';
  });

  document.getElementById('installBtn').addEventListener('click', () => {
    deferredPrompt.prompt(); deferredPrompt.userChoice.then(() => deferredPrompt = null);
  });
</script>

